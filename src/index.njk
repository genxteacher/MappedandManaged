---
layout: base.njk
permalink: /
---
{%- from "partials/macros.njk" import video, product_card -%}
<section class="hero">
  <div class="wrap">
    <p class="eyebrow">For interventionists, SPED case managers &amp; MTSS teams</p>
    <h1><span class="teach">Read it closely.</span><br><span class="track">Track it simply.</span></h1>
    <p class="lead">IEP goal banks and caseload trackers, small-group planners and data trackers, MTSS data systems in Excel and Google Sheets, and multisyllabic decoding for older readers. Tools that do the busywork for you.</p>
    <div class="hero-cta">
      <a class="btn btn--coral" href="/shop/">Browse the tools</a>
      <a class="btn btn--ghost" href="/free-tools/">Free tools</a>
    </div>
  </div>
</section>

<section class="section section--paper">
  <div class="wrap">
    <p class="eyebrow">Four lanes</p>
    <h2>Pick what you need</h2>
    <div class="grid grid--4 mt-2">
      {%- set lanes = [
        ["iep", "Managed IEP", site.colors.gold, "IEP documentation and progress monitoring for SPED case managers."],
        ["systems", "Teacher Systems", site.colors.coral, "Scheduling, planning and data tracking for interventionists."],
        ["mtss", "Managed MTSS", site.colors.mtss, "Screening, tiering, progress monitoring and attendance for RTI/MTSS teams."],
        ["literacy", "Mapped Literacy", site.colors.sage, "Syllable division and multisyllabic decoding for grades 3–8."]
      ] %}
      {%- for l in lanes %}
      <a class="card card--lane" style="--accent:{{ l[2] }};--accent-ink:{{ l[2] | ink }}" href="/shop/#{{ l[0] }}">
        <span class="lane-tag">{{ l[1] }}</span>
        <p>{{ l[3] }}</p>
        <span class="card-foot"><strong>See the {{ l[1] }} tools &rarr;</strong></span>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <p class="eyebrow">See inside</p>
    <h2>Twenty seconds each, pages and all</h2>
    <div class="vids mt-2">
      {%- for p in products %}{% if p.number == 25 or p.number == 21 %}
      {{ video(p, p.name, p.laneLabel) }}
      {%- endif %}{% endfor %}
    </div>
  </div>
</section>

<section class="section section--paper">
  <div class="wrap">
    <p class="eyebrow">Start free</p>
    <h2>Try something before you buy anything</h2>
    <div class="grid grid--3 grid--shop mt-2">
      {%- for f in products %}{% if f.free %}
      {{ product_card(f) }}
      {%- endif %}{% endfor %}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="callout" style="--accent:{{ site.colors.gold }}">
      <h3>Teaching Indiana ELA?</h3>
      <p>Indiana ILEARN ELA practice for grades 3&ndash;8, IREAD-3 practice and free checkpoint screeners now have their own site. <a href="https://elaclass38.com/">Go to elaclass38.com &rarr;</a></p>
    </div>
  </div>
</section>
